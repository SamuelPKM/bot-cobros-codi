# Copia este archivo a .env.local. Nunca subas .env.local al repositorio.

# URL de la API de Nest (backend/). Solo la usa el servidor de Next: no lleva
# NEXT_PUBLIC_ porque el navegador nunca llama a la API directamente.
API_URL=http://localhost:3000

# Mismo valor que FRONT_PROXY_SECRET de la API. Con él, la web manda la IP del visitante
# (la última de X-Forwarded-For, la que puso el proxy de la plataforma) para que los
# límites por IP de la API cuenten a cada persona y no a este servidor. Opcional en local.
# FRONT_PROXY_SECRET=
