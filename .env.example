# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# Postgres. Local: el de docker-compose. Producción: la cadena de conexión de Neon.
DATABASE_URL=postgres://cobrale:cobrale@localhost:5433/cobrale
# true en Neon
DATABASE_SSL=false

# Secreto para firmar las sesiones de la app (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Vigencia del Bearer token (15m, 12h, 1d). Por defecto 12h
# JWT_TTL=12h

# Admin que se crea al arrancar si todavía no hay ninguno (opcional; contraseña de 8+)
# ADMIN_USERNAME=dueno
# ADMIN_PASSWORD=

# pey: portal.mipey.mx > Desarrollador > Crear API Key
PEY_API_KEY=
# Engrane de la API key > Crear Webhook. Empieza con whsec_
PEY_WEBHOOK_SECRET=
# PEY_BASE_URL=https://api.pey.mx

# Nombre del negocio (máx. 30). Va al inicio del concepto que ve quien paga en su banco,
# porque el banco solo muestra al titular de la cuenta. Por defecto "Cóbrale"
# BUSINESS_NAME=Tacos Ana

# PORT=3000
