# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# --- pey (obligatorio) ---

# API key de pey (portal.pey.mx > Desarrollador > Crear API Key)
PEY_API_KEY=

# Secreto del webhook (engrane de la API key > Crear Webhook). Empieza con whsec_
PEY_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (opcional; se configura completo o nada) ---

# Token de acceso de la app de Meta
WHATSAPP_TOKEN=

# ID del número de teléfono (no el número): WhatsApp > Configuración de la API
WHATSAPP_PHONE_NUMBER_ID=

# Secreto de la app: Configuración de la app > Básica. Con él se verifica la firma de los webhooks
WHATSAPP_APP_SECRET=

# Texto que tú inventas; se escribe igual al registrar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=

# Comerciantes que pueden cobrar: teléfono=Nombre del negocio, separados por punto y coma.
# El nombre aparece en el concepto que ve quien paga.
MERCHANTS=5512345678=Mi Negocio

# --- Opcionales ---

# URL pública HTTPS del servidor. Hace falta para las ligas de pago (plan B)
# PUBLIC_BASE_URL=https://mi-bot.example.com

# --- Demo web pública en /demo (cobros reales, con límites) ---
# DEMO_ENABLED=true
# DEMO_MAX_AMOUNT=1
# DEMO_MERCHANT_NAME=Negocio de prueba

# true si el servidor está detrás de un proxy (casi cualquier hosting)
# TRUST_PROXY=true

# PORT=3000
# DATABASE_FILE=data/cobros.db
# PEY_BASE_URL=https://api.pey.mx
# WHATSAPP_API_VERSION=v23.0
