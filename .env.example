# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

# --- pey (obligatorio) ---

# API key de pey (portal.pey.mx > Desarrollador > Crear API Key)
PEY_API_KEY=

# Secreto del webhook (engrane de la API key > Crear Webhook). Empieza con whsec_
PEY_WEBHOOK_SECRET=

# --- Base de datos ---

# Postgres, por ejemplo Neon (usa la cadena de conexión directa, sin "-pooler").
# Sin DATABASE_URL se usa PGlite y se guarda en DATABASE_DIR.
# DATABASE_URL=postgres://usuario:clave@host/base?sslmode=require
# DATABASE_DIR=data/pglite

# --- Web ---

# URL pública HTTPS. En Render se toma sola. Hace falta para las ligas de pago.
# PUBLIC_BASE_URL=https://cobrale.onrender.com

# true detrás de un proxy (casi cualquier hosting)
# TRUST_PROXY=true

# Cuenta para el jurado, siempre en modo prueba. Se crea al arrancar.
# DEMO_ACCOUNT_EMAIL=jurado@ejemplo.com
# DEMO_ACCOUNT_PASSWORD=

# Correos que cobran sin el límite del modo prueba aunque no tengan CLABE propia
# TRUSTED_EMAILS=equipo@ejemplo.com

# false cierra el registro de cuentas nuevas
# REGISTRATION_OPEN=true

# --- Modo prueba y demo pública en /demo ---

# DEMO_ENABLED=true
# Monto máximo por cobro en modo prueba (demo y cuentas sin CLABE activa)
# DEMO_MAX_AMOUNT=1
# DEMO_MERCHANT_NAME=Negocio de prueba

# --- WhatsApp Cloud API (opcional; se configura completo o nada) ---

# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Número del bot, para mostrarlo en la web al ligar un WhatsApp
# WHATSAPP_DISPLAY_NUMBER=55 1234 5678
# WHATSAPP_API_VERSION=v23.0

# PORT=3000
# PEY_BASE_URL=https://api.pey.mx
