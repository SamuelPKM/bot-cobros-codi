{
  "name": "bot-cobros-codi",
  "version": "0.1.0",
  "description": "Bot de cobros CoDi por WhatsApp sobre la API de pey",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
