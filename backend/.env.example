# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.
#
# No hay credenciales de pey aquí: cada negocio registra SU propia API key con
# POST /businesses (regla 7.3(c) del hackatón). Se guardan cifradas.

# Postgres. Local: el de docker-compose. Producción: la cadena DIRECTA de Neon.
DATABASE_URL=postgres://cobrale:cobrale@localhost:5433/cobrale
# true en Neon
DATABASE_SSL=false

# Secreto para firmar las sesiones de la app (mínimo 32 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Vigencia del Bearer token (15m, 12h, 1d). Por defecto 12h
# JWT_TTL=12h

# Llave que cifra las API keys y secretos de webhook de los negocios: 32 bytes en base64.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la cambias, las credenciales guardadas ya no se pueden descifrar.
ENCRYPTION_KEY=

# URL pública HTTPS de esta API, para mostrar a cada negocio la URL de su webhook
# PUBLIC_BASE_URL=https://cobrale-api.onrender.com

# Origen de la web (Next.js). Nest no sirve pantallas: con esto arma las ligas a las
# del frontend (aceptar invitación, regreso de la liga de pago). http solo en localhost
# FRONTEND_URL=http://localhost:3001

# PEY_BASE_URL=https://api.pey.mx

# Expo Push: solo si activas "Enhanced Security for Push Notifications" en expo.dev
# EXPO_ACCESS_TOKEN=

# Barrido cada 30 s (vence cobros, concilia con pey y reintenta avisos). Por defecto true
# SWEEPER_ENABLED=true

# true detrás de un proxy (Render), para que los límites vean la IP real del cliente
# TRUST_PROXY=false

# Orígenes de navegador que pueden llamar la API (la demo de Expo web), separados por coma
# CORS_ORIGINS=http://localhost:8081

# WhatsApp Cloud API (Meta). Opcional: las cuatro o ninguna.
# Token y Phone number ID: developers.facebook.com → tu app → WhatsApp → Configuración de la API
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Secreto de la app (Configuración → Básica): verifica la firma de cada webhook
# WHATSAPP_APP_SECRET=
# Texto que tú eliges y pegas también en Meta al registrar https://<api>/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_API_VERSION=v23.0

# PORT=3000
